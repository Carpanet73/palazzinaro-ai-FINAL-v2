```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python specific (if applicable)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
.envrc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node specific (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.jscs
.jshint
.npm
.nyc_output
.nyc
.eslintcache
.coverage
.nyc_output
istanbul.yml
.nyc
