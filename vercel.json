{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/extract.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/cron-close-fast-closing.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-close-fast-closing",
      "schedule": "0 2 1 * *"
    }
  ]
}
