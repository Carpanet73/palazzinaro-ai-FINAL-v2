rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────────
    // HELPERS
    // ───────────────────────────────────────────────────────────────────────

    // User must be authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // For collections where each doc has a `userId` field, the requesting
    // user can only read/write docs that belong to them.
    function isOwner() {
      return isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // On create, the doc must stamp itself with the requester's uid
    function stampsOwner() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // ───────────────────────────────────────────────────────────────────────
    // Per-user profile document (one doc per user, keyed by uid)
    // ───────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:  if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /ownerProfiles/{userId} {
      allow read:  if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ───────────────────────────────────────────────────────────────────────
    // User-scoped domain collections (every doc carries a `userId` field)
    //
    // CORREZIONE — bug critico: prima "delete" era raggruppato con "update" nella
    // stessa regola, che controllava anche `request.resource.data.userId`. Ma in
    // una cancellazione non esiste nessun `request.resource` (non si manda nessun
    // dato nuovo) — quella condizione falliva SEMPRE, e Firestore rifiutava ogni
    // cancellazione in silenzio, senza che l'app se ne accorgesse. Ora "delete" è
    // una regola a sé, che richiede solo di essere il proprietario del dato.
    // ───────────────────────────────────────────────────────────────────────

    match /properties/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /contracts/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /tenants/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /owners/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /administrators/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /condominiums/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    // Ripartizione spese condominiali senza amministratore (29/08/2026)
    match /selfManagedBuildings/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /meterReadings/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /sharedExpenses/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /movements/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /fastClosing/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /reminders/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /maintenance/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /legalCases/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /communications/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /lawyers/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /creditInstitutions/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /bankAccounts/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /insurancePolicies/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    match /deliveryReports/{id} {
      allow read:   if isOwner();
      allow create: if stampsOwner();
      allow update: if isOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    // ───────────────────────────────────────────────────────────────────────
    // Documento singolo per utente (chiave = userId), es. periodo attivo Fast Closing
    // ───────────────────────────────────────────────────────────────────────

    match /appState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ───────────────────────────────────────────────────────────────────────
    // Default deny — anything not explicitly allowed above is blocked
    // ───────────────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
